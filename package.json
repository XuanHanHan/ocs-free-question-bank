{
  "name": "ocs-free-question-bank",
  "version": "1.13.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "ocs:config": "node --env-file=.env print-ocs-config.mjs",
    "linux:login": "node --env-file=.env linux-worker.mjs --login",
    "linux:start": "node --env-file=.env linux-worker.mjs",
    "test": "node --test bridge.test.mjs web-server.test.mjs",
    "test:linux": "node --test linux-worker.test.mjs",
    "test:all": "node --test bridge.test.mjs web-server.test.mjs linux-worker.test.mjs"
  },
  "dependencies": { "playwright": "1.64.0" }
}
